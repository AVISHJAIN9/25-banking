# AegisBank Backend Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
# Note: For full ACID transactions, connect to a MongoDB Replica Set (or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/aegisbank

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Frontend Integration (Approved CORS Origins)
FRONTEND_URL=http://localhost:5173

# Email Service (Nodemailer OAuth2 - Optional in development)
EMAIL_USER=notifications@yourdomain.com
CLIENT_ID=your_google_oauth2_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_oauth2_client_secret
REFRESH_TOKEN=your_oauth2_refresh_token
